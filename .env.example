SERVICE_NAME=vam-ai-agent-service
ENVIRONMENT=local
API_PREFIX=/api/v1
LOG_LEVEL=INFO

APP_NAME=vam-ai-agent-service
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

ASSISTANT_JWT_SECRET=
ASSISTANT_JWT_ALGORITHM=HS512
ASSISTANT_JWT_ISSUER=aftermarket-backend
ASSISTANT_JWT_AUDIENCE=vam-python-assistant
ASSISTANT_SESSION_TTL_SECONDS=600

VAM_BACKEND_BASE_URL=https://vam-backend.com
VAM_INTERNAL_API_TIMEOUT_SECONDS=10

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
