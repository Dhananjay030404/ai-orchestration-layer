ELEVENLABS_TIMEOUT_SECONDS=10

SESSION_REPOSITORY_BACKEND=mysql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=VAM_AI_AGENT 
MYSQL_USER=myuser
MYSQL_PASSWORD=StrongPassword123!
MYSQL_POOL_MIN_SIZE=1
